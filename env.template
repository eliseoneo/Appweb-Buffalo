# =========================================
# Buffalo AI - Environment Configuration Template
# =========================================
# Copy this content to .env.local and fill in your values

# =========================================
# 🌐 APPLICATION
# =========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =========================================
# 🔐 AUTHENTICATION
# =========================================
JWT_SECRET="buffalo-ai-dashboard-2024-secret-key-CHANGE-THIS-IN-PRODUCTION"

# Admin credentials (used for initial setup)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_COMPANY="Your Company Name"

# =========================================
# 🗄️ LOCAL DATABASE (Destination)
# =========================================
# Your local PostgreSQL database
# This is where cloud data will be synced TO
DATABASE_URL="postgresql://buffalo_user:buffalo_password_2024@localhost:5432/buffalo_dashboard"

# =========================================
# ☁️ CLOUD DATABASE (Source)
# =========================================
# Your cloud/remote PostgreSQL database
# This is where cloud data will be synced FROM
# Required for database sync functionality
DATABASE_URL_CLOUD="postgresql://username:password@host:port/database_name"

# Example cloud URLs:
# - Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# - Neon: postgresql://[user]:[password]@[host]/[database]?sslmode=require
# - Railway: postgresql://postgres:[password]@[host]:[port]/railway
# - Heroku: postgres://[user]:[password]@[host]:[port]/[database]
# - AWS RDS: postgresql://[user]:[password]@[endpoint]:[port]/[database]

# =========================================
# 📝 NOTES
# =========================================
# 1. Never commit .env.local with real credentials
# 2. Keep .env.local in .gitignore
# 3. Use strong passwords in production
# 4. DATABASE_URL_CLOUD is only needed for sync functionality
# 5. Test your configuration with: npm run db:test-setup

